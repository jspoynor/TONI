# Set these in your shell or process manager; the API does not auto-load this file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/nemo
NEMO_STORAGE=storage
# Worker only: path to your PRIVATE OpenAI key file. Never commit that file.
OPENAI_ENV_FILE=/absolute/path/to/private/.env
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
