            "default": "monthly"
          },
          "period_start": {
            "type": "string",
            "title": "Period Start"
          },
          "period_end": {
            "type": "string",
            "title": "Period End"
          },
          "due_date": {
            "type": "string",
            "title": "Due Date"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "USD"
          },
          "required_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Fields"
          },
          "arr_applicable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arr Applicable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "period_start",
          "period_end",
          "due_date"
        ],
        "title": "RequestCreate"
      },
      "Submission": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "reviewed_hash": {
            "type": "string",
            "title": "Reviewed Hash"
          },
          "company_confirmed": {
            "type": "boolean",
            "title": "Company Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "reviewed_hash",
          "company_confirmed"
        ],
        "title": "Submission"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
