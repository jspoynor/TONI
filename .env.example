# Copy to .env.local (gitignored) to connect Anne's chat (/submit-statements)
# to a real Nemo backend. See backend/FRONTEND_INTEGRATION.md and
# backend/README.md for running the backend and provisioning a company token.
# Leave either value unset to keep Anne on the mock reply, unchanged.
VITE_API_BASE_URL=http://127.0.0.1:8010
VITE_ANNE_COMPANY_TOKEN=paste-the-company-token-from-backend/demo-credentials.json
